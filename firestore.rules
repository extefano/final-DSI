rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProgress(data, userId) {
      return data.keys().hasAll([
          'uid',
          'completedIds',
          'reviewQueue',
          'streak',
          'bestStreak',
          'totalAttempts',
          'totalCorrect',
          'theme',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'completedIds',
          'reviewQueue',
          'streak',
          'bestStreak',
          'totalAttempts',
          'totalCorrect',
          'theme',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && data.completedIds is list
        && data.completedIds.size() <= 300
        && (data.completedIds.size() == 0 || (data.completedIds[0] is string && data.completedIds[0].size() <= 64))
        && data.reviewQueue is map
        && data.reviewQueue.size() <= 300
        && data.streak is int
        && data.streak >= 0
        && data.streak <= 100000
        && data.bestStreak is int
        && data.bestStreak >= 0
        && data.bestStreak <= 100000
        && data.totalAttempts is int
        && data.totalAttempts >= 0
        && data.totalAttempts <= 1000000
        && data.totalCorrect is int
        && data.totalCorrect >= 0
        && data.totalCorrect <= data.totalAttempts
        && data.theme is string
        && data.theme in ['light', 'dark']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidUserProgress(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidUserProgress(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'completedIds',
          'reviewQueue',
          'streak',
          'bestStreak',
          'totalAttempts',
          'totalCorrect',
          'theme',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId) && isVerified();
    }
  }
}

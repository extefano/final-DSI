rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidActiveSession(session) {
      return session is map
        && session.keys().hasAll([
          'view',
          'unitId',
          'exerciseIndex',
          'sessionCorrect',
          'sessionTotal'
        ])
        && session.keys().hasOnly([
          'view',
          'unitId',
          'exerciseIndex',
          'sessionCorrect',
          'sessionTotal',
          'oralMode',
          'oralQueueIds'
        ])
        && session.view is string
        && session.view in ['units', 'study', 'review', 'oral']
        && session.unitId is string
        && session.unitId.size() <= 32
        && session.unitId.matches('^[a-zA-Z0-9_\\-]*$')
        && (session.view != 'study' || session.unitId.size() >= 1)
        && session.exerciseIndex is int
        && session.exerciseIndex >= 0
        && session.exerciseIndex <= 500
        && session.sessionCorrect is int
        && session.sessionCorrect >= 0
        && session.sessionCorrect <= 500
        && session.sessionTotal is int
        && session.sessionTotal >= 0
        && session.sessionTotal <= 500
        && session.sessionCorrect <= session.sessionTotal
        && (!('oralMode' in session) || (session.oralMode is string && session.oralMode in ['mixed', 'weak', 'traps']))
        && (!('oralQueueIds' in session) || (
          session.oralQueueIds is list
          && session.oralQueueIds.size() <= 100
          && (session.oralQueueIds.size() == 0 || (session.oralQueueIds[0] is string && session.oralQueueIds[0].size() <= 64))
        ));
    }

    function isValidUserProgress(data, userId) {
      return data.keys().hasAll([
          'uid',
          'completedIds',
          'reviewQueue',
          'streak',
          'bestStreak',
          'totalAttempts',
          'totalCorrect',
          'theme',
          'activeSession',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'completedIds',
          'reviewQueue',
          'oralRatings',
          'streak',
          'bestStreak',
          'totalAttempts',
          'totalCorrect',
          'theme',
          'activeSession',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && data.completedIds is list
        && data.completedIds.size() <= 300
        && (data.completedIds.size() == 0 || (data.completedIds[0] is string && data.completedIds[0].size() <= 64))
        && data.reviewQueue is map
        && data.reviewQueue.size() <= 300
        && (!('oralRatings' in data) || (data.oralRatings is map && data.oralRatings.size() <= 200))
        && data.streak is int
        && data.streak >= 0
        && data.streak <= 100000
        && data.bestStreak is int
        && data.bestStreak >= 0
        && data.bestStreak <= 100000
        && data.totalAttempts is int
        && data.totalAttempts >= 0
        && data.totalAttempts <= 1000000
        && data.totalCorrect is int
        && data.totalCorrect >= 0
        && data.totalCorrect <= data.totalAttempts
        && data.theme is string
        && data.theme in ['light', 'dark']
        && isValidActiveSession(data.activeSession)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidUserProgress(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidUserProgress(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'completedIds',
          'reviewQueue',
          'oralRatings',
          'streak',
          'bestStreak',
          'totalAttempts',
          'totalCorrect',
          'theme',
          'activeSession',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId) && isVerified();
    }
  }
}
